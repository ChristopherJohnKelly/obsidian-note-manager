# Production stack configuration — docker-compose.prod.yml
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL password shared by the postgres service and Temporal's
# connection (POSTGRES_PWD on temporal-server).
POSTGRES_PASSWORD=changeme

# Path of the Obsidian vault inside the vault-worker container (also the
# mount point of the vault-data named volume).
VAULT_PATH=/vault

# GitHub repository URL of the vault (cloned/pushed by vault-worker).
REPO_URL=https://github.com/ChristopherJohnKelly/obsidian-notes

# GitHub Personal Access Token with `repo` scope (vault-worker git ops
# and github-runner registration).
GITHUB_PAT=ghp_your_token_here

# Google Gemini API key for LLM activities on vault-worker.
GEMINI_API_KEY=AIza_your_key_here

# Display name for the self-hosted runner (optional; defaults to
# obsidian-runner).
RUNNER_NAME=obsidian-runner

# Vault context code forwarded into triggered workflows by github-runner.
CONTEXT_CODE=OBSE

# GitHub repository owner/name forwarded into triggered workflows.
REPO_OWNER=ChristopherJohnKelly
REPO_NAME=obsidian-notes

# GitHub token used by triggered workflows to open PRs.
GITHUB_TOKEN=ghp_your_token_here

# Branch name used by triggered workflows when opening PRs.
PR_BRANCH=main
